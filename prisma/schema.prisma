// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                                  Int                 @id @default(autoincrement())
  googleId                            String?             @unique @map("google_id")
  username                            String              @unique @db.VarChar(100)
  email                               String              @unique @db.VarChar(255)
  passwordHash                        String              @map("password_hash") @db.VarChar(255)
  firstName                           String?             @map("first_name") @db.VarChar(100)
  lastName                            String?             @map("last_name") @db.VarChar(100)
  phoneNumber                         String?             @map("phone_number") @db.VarChar(20)
  address                             String?
  city                                String?             @db.VarChar(100)
  province                            String?             @db.VarChar(100)
  country                             String?             @db.VarChar(100)
  postalCode                          String?             @map("postal_code") @db.VarChar(10)
  dateOfBirth                         DateTime?           @map("date_of_birth") @db.Date
  gender                              String?             @db.VarChar(10) // ENUM 'M', 'F', 'Other'
  profilePictureUrl                   String?             @map("profile_picture_url")
  userRoleId                          Int                 @map("user_role_id")
  status                              String?             @default("active") @db.VarChar(50) // ENUM 'active', 'inactive', 'suspended'
  lastLoginAt                         DateTime?           @map("last_login_at") @db.Timestamptz(6)
  metadataJson                        Json?               @map("metadata_json")
  internalNotes                       String?             @map("internal_notes")
  createdAt                           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles                           UserRoles           @relation(fields: [userRoleId], references: [id], onDelete: Restrict)
  userRolesLastModifiedByUsersTousers UserRoles[]         @relation("user_roles_last_modified_byTousers")
  subjects                            Subjects[]          @relation("SubjectLastReviewedBy")
  topics                              Topics[]            @relation("TopicLastUpdatedBy")
  questionBanksCreatedBy              QuestionBanks[]     @relation("QuestionBankCreatedBy")
  questionBanksReviewedBy             QuestionBanks[]     @relation("QuestionBankReviewedBy")
  questionsCreatedBy                  Questions[]         @relation("QuestionCreatedBy")
  questionsReviewedBy                 Questions[]         @relation("QuestionReviewedBy")
  answers                             Answers[]           @relation("AnswerLastModifiedBy")
  questionBankItemsAddedBy            QuestionBankItems[] @relation("QuestionBankItemAddedBy")
  orders                              Orders[]
  payments                            Payments[]
  coursesInstructor                   Courses[]           @relation("CourseInstructor")
  coursesCreatedBy                    Courses[]           @relation("CourseCreatedBy")
  modules                             Modules[]           @relation("ModuleLastModifiedBy")
  lessons                             Lessons[]           @relation("LessonLastUpdatedBy")
  userCourses                         UserCourses[]
  progressTracking                    ProgressTracking[]
  examsCreatedBy                      Exams[]             @relation("ExamCreatedBy")
  examQuestions                       ExamQuestions[]     @relation("ExamQuestionAddedBy")
  userExams                           UserExams[]
  userExamAnswersGrader               UserExamAnswers[]   @relation("UserExamAnswerGrader")
  userExamAnswersLastModified         UserExamAnswers[]   @relation("UserExamAnswerLastModifiedBy")
  notificationsReceived               Notifications[]     @relation("NotificationsReceived")
  notificationsSent                   Notifications[]     @relation("NotificationSender")
  reviewsSubmitted                    Reviews[]           @relation("ReviewsSubmitted")
  reviewsApproved                     Reviews[]           @relation("ReviewApprovedBy")
  couponsCreatedBy                    Coupons[]           @relation("CouponCreatedBy")
  couponsLastModifiedBy               Coupons[]           @relation("CouponLastModifiedBy")
  certificates                        Certificates[]      @relation("UserCertificates")
  assets                              Assets[]            @relation("AssetUploadedBy")

  @@map("users")
}

model UserRoles {
  id                  Int      @id @default(autoincrement())
  roleName            String   @unique @map("role_name") @db.VarChar(100)
  description         String?
  permissionsJson     Json?    @map("permissions_json")
  canManageUsers      Boolean? @default(false) @map("can_manage_users")
  canCreateContent    Boolean? @default(false) @map("can_create_content")
  canViewReports      Boolean? @default(false) @map("can_view_reports")
  canAccessAdminPanel Boolean? @default(false) @map("can_access_admin_panel")
  hierarchyLevel      Int?     @default(1) @map("hierarchy_level")
  isSystemRole        Boolean? @default(false) @map("is_system_role")
  defaultDashboardUrl String?  @map("default_dashboard_url")
  apiAccessLevel      String?  @map("api_access_level") @db.VarChar(50)
  relatedModuleAccess Json?    @map("related_module_access")
  auditLogJson        Json?    @map("audit_log_json")
  internalComments    String?  @map("internal_comments")
  externalReferenceId String?  @map("external_reference_id") @db.VarChar(100)
  versionControl      String?  @map("version_control") @db.VarChar(50)
  lastModifiedBy      Int?     @map("last_modified_by")
  isActive            Boolean? @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users               Users[]
  lastModifiedByUser  Users?   @relation("user_roles_last_modified_byTousers", fields: [lastModifiedBy], references: [id])

  @@map("user_roles")
}

model Subjects {
  id                    Int             @id @default(autoincrement())
  subjectName           String          @unique @map("subject_name") @db.VarChar(255)
  description           String?
  iconUrl               String?         @map("icon_url")
  isActive              Boolean?        @default(true) @map("is_active")
  totalQuestionsCount   Int?            @default(0) @map("total_questions_count")
  totalCoursesCount     Int?            @default(0) @map("total_courses_count")
  averageDifficulty     Decimal?        @map("average_difficulty") @db.Decimal(3, 2)
  relatedFieldOfStudy   String?         @map("related_field_of_study") @db.VarChar(255)
  syllabusOutline       String?         @map("syllabus_outline")
  externalResourceLinks Json?           @map("external_resource_links")
  suggestedGradeLevels  String?         @map("suggested_grade_levels") @db.VarChar(100)
  commonMisconceptions  String?         @map("common_misconceptions")
  keyConcepts           String?         @map("key_concepts")
  learningObjectives    String?         @map("learning_objectives")
  assessmentMethods     String?         @map("assessment_methods")
  lastReviewedBy        Int?            @map("last_reviewed_by")
  metadataJson          Json?           @map("metadata_json")
  internalNotes         String?         @map("internal_notes")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  topics                Topics[]
  questionBanks         QuestionBanks[]
  questions             Questions[]
  courses               Courses[]
  exams                 Exams[]
  lastReviewedByUser    Users?          @relation("SubjectLastReviewedBy", fields: [lastReviewedBy], references: [id])

  @@map("subjects")
}

model Topics {
  id                         Int             @id @default(autoincrement())
  topicName                  String          @map("topic_name") @db.VarChar(255)
  subjectId                  Int             @map("subject_id")
  description                String?
  totalQuestionsCount        Int?            @default(0) @map("total_questions_count")
  totalLessonsCount          Int?            @default(0) @map("total_lessons_count")
  averageScore               Decimal?        @map("average_score") @db.Decimal(5, 2)
  prerequisiteTopics         Json?           @map("prerequisite_topics")
  relatedKeywords            String?         @map("related_keywords")
  learningMaterialsSuggested String?         @map("learning_materials_suggested")
  commonErrors               String?         @map("common_errors")
  historicalContext          String?         @map("historical_context")
  realWorldApplications      String?         @map("real_world_applications")
  learningTips               String?         @map("learning_tips")
  quizAverageScore           Decimal?        @map("quiz_average_score") @db.Decimal(5, 2)
  revisionFrequency          Int?            @default(0) @map("revision_frequency")
  isAdvanced                 Boolean?        @default(false) @map("is_advanced")
  externalReferenceId        String?         @map("external_reference_id") @db.VarChar(100)
  lastUpdatedBy              Int?            @map("last_updated_by")
  metadataJson               Json?           @map("metadata_json")
  internalNotes              String?         @map("internal_notes")
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subject                    Subjects        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lastUpdatedByUser          Users?          @relation("TopicLastUpdatedBy", fields: [lastUpdatedBy], references: [id])
  questionBanks              QuestionBanks[]
  questions                  Questions[]

  @@map("topics")
}

model QuestionBanks {
  id                           Int                 @id @default(autoincrement())
  bankName                     String              @map("bank_name") @db.VarChar(255)
  description                  String?
  subjectId                    Int                 @map("subject_id")
  topicId                      Int?                @map("topic_id")
  price                        Decimal?            @default(0.00) @db.Decimal(10, 2)
  status                       String?             @default("draft") @db.VarChar(50) // ENUM 'draft', 'published', 'archived'
  totalQuestions               Int?                @default(0) @map("total_questions")
  accessDurationDays           Int?                @map("access_duration_days")
  lastReviewedAt               DateTime?           @map("last_reviewed_at") @db.Timestamptz(6)
  reviewedByUserId             Int?                @map("reviewed_by_user_id")
  versionNumber                String?             @map("version_number") @db.VarChar(50)
  language                     String?             @default("id") @db.VarChar(50)
  targetAudience               String?             @map("target_audience")
  usageGuidelines              String?             @map("usage_guidelines")
  licensingDetails             String?             @map("licensing_details")
  isPremium                    Boolean?            @default(false) @map("is_premium")
  tags                         Json?
  averageCompletionTimeMinutes Int?                @map("average_completion_time_minutes")
  externalId                   String?             @map("external_id") @db.VarChar(100)
  metadataJson                 Json?               @map("metadata_json")
  internalNotes                String?             @map("internal_notes")
  createdByUserId              Int                 @map("created_by_user_id")
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subject                      Subjects            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                        Topics?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdByUser                Users               @relation("QuestionBankCreatedBy", fields: [createdByUserId], references: [id])
  reviewedByUser               Users?              @relation("QuestionBankReviewedBy", fields: [reviewedByUserId], references: [id])
  questions                    Questions[]         @relation("questions_question_bank_id_fkey")
  questionBankItems            QuestionBankItems[]

  @@map("question_banks")
}

model Questions {
  id                   Int                 @id @default(autoincrement())
  questionBankId       Int?                @map("question_bank_id")
  subjectId            Int                 @map("subject_id")
  topicId              Int?                @map("topic_id")
  questionText         String              @map("question_text")
  questionType         String              @map("question_type") @db.VarChar(50) // ENUM 'multiple_choice', 'essay', 'true_false', 'fill_in_the_blank'
  difficultyLevel      String?             @default("medium") @map("difficulty_level") @db.VarChar(50) // ENUM 'easy', 'medium', 'hard'
  imageUrl             String?             @map("image_url")
  audioUrl             String?             @map("audio_url")
  videoUrl             String?             @map("video_url")
  explanationText      String?             @map("explanation_text")
  correctAnswerId      Int?                @map("correct_answer_id")
  points               Int?                @default(1)
  timeLimitPerQuestion Int?                @map("time_limit_per_question")
  tags                 Json?
  isActive             Boolean?            @default(true) @map("is_active")
  createdByUserId      Int                 @map("created_by_user_id")
  reviewedByUserId     Int?                @map("reviewed_by_user_id")
  lastReviewDate       DateTime?           @map("last_review_date") @db.Timestamptz(6)
  sourceReference      String?             @map("source_reference")
  commonMistakes       String?             @map("common_mistakes")
  metadataJson         Json?               @map("metadata_json")
  internalNotes        String?             @map("internal_notes")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questionBank         QuestionBanks?      @relation("questions_question_bank_id_fkey", fields: [questionBankId], references: [id], onDelete: SetNull)
  subject              Subjects            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topics?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  answers              Answers[]
  questionBankItems    QuestionBankItems[]
  examQuestions        ExamQuestions[]
  userExamAnswers      UserExamAnswers[]
  createdByUser        Users               @relation("QuestionCreatedBy", fields: [createdByUserId], references: [id])
  reviewedByUser       Users?              @relation("QuestionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@map("questions")
}

model Answers {
  id                      Int               @id @default(autoincrement())
  questionId              Int               @map("question_id")
  answerText              String            @map("answer_text")
  isCorrect               Boolean?          @default(false) @map("is_correct")
  feedbackText            String?           @map("feedback_text")
  imageUrl                String?           @map("image_url")
  orderNumber             Int?              @map("order_number")
  pointsIfSelected        Int?              @default(0) @map("points_if_selected")
  justificationForCorrect String?           @map("justification_for_correct")
  alternativeAnswerForms  String?           @map("alternative_answer_forms")
  sourceReference         String?           @map("source_reference")
  versionId               String?           @map("version_id") @db.VarChar(50)
  externalId              String?           @map("external_id") @db.VarChar(100)
  lastModifiedBy          Int?              @map("last_modified_by")
  isActive                Boolean?          @default(true) @map("is_active")
  metadataJson            Json?             @map("metadata_json")
  internalNotes           String?           @map("internal_notes")
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  question                Questions         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lastModifiedByUser      Users?            @relation("AnswerLastModifiedBy", fields: [lastModifiedBy], references: [id])
  userExamAnswers         UserExamAnswers[]

  @@map("answers")
}

model QuestionBankItems {
  id                       Int           @id @default(autoincrement())
  questionBankId           Int           @map("question_bank_id")
  questionId               Int           @map("question_id")
  orderInBank              Int?          @map("order_in_bank")
  difficultyOverride       String?       @map("difficulty_override") @db.VarChar(50)
  isRequired               Boolean?      @default(false) @map("is_required")
  pointsOverride           Int?          @map("points_override")
  timeLimitOverrideSeconds Int?          @map("time_limit_override_seconds")
  notesForThisItem         String?       @map("notes_for_this_item")
  categoryInBank           String?       @map("category_in_bank") @db.VarChar(100)
  addedByUserId            Int?          @map("added_by_user_id")
  statusInBank             String?       @map("status_in_bank") @db.VarChar(50)
  lastModifiedDate         DateTime?     @map("last_modified_date") @db.Timestamptz(6)
  versionControl           String?       @map("version_control") @db.VarChar(50)
  externalReferenceId      String?       @map("external_reference_id") @db.VarChar(100)
  metadataJson             Json?         @map("metadata_json")
  internalComments         String?       @map("internal_comments")
  relatedTags              Json?         @map("related_tags")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questionBank             QuestionBanks @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  question                 Questions     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  addedByUser              Users?        @relation("QuestionBankItemAddedBy", fields: [addedByUserId], references: [id])

  @@unique([questionBankId, questionId])
  @@map("question_bank_items")
}

model Orders {
  id              Int          @id @default(autoincrement())
  userId          Int          @map("user_id")
  orderDate       DateTime     @default(now()) @map("order_date") @db.Timestamptz(6)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(10, 2)
  paymentStatus   String?      @default("pending") @map("payment_status") @db.VarChar(50) // ENUM 'pending', 'paid', 'failed', 'refunded'
  shippingAddress String?      @map("shipping_address")
  couponCode      String?      @map("coupon_code") @db.VarChar(50)
  discountAmount  Decimal?     @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount       Decimal?     @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  grandTotal      Decimal      @map("grand_total") @db.Decimal(10, 2)
  paymentMethod   String?      @map("payment_method") @db.VarChar(100)
  transactionId   String?      @unique @map("transaction_id") @db.VarChar(255)
  orderStatus     String?      @default("created") @map("order_status") @db.VarChar(50) // ENUM 'created', 'processing', 'completed', 'cancelled'
  notes           String?
  billingAddress  String?      @map("billing_address")
  ipAddress       String?      @map("ip_address")
  deviceInfo      String?      @map("device_info")
  currency        String?      @default("IDR") @db.VarChar(10)
  deliveryStatus  String?      @default("N/A") @map("delivery_status") @db.VarChar(50)
  trackingNumber  String?      @map("tracking_number") @db.VarChar(100)
  internalRemarks String?      @map("internal_remarks")
  metadataJson    Json?        @map("metadata_json")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems      OrderItems[]
  payments        Payments[]

  @@map("orders")
}

model OrderItems {
  id               Int       @id @default(autoincrement())
  orderId          Int       @map("order_id")
  itemType         String    @map("item_type") @db.VarChar(50) // ENUM 'question_bank', 'course', 'exam_access'
  itemId           Int       @map("item_id")
  quantity         Int?      @default(1)
  pricePerItem     Decimal   @map("price_per_item") @db.Decimal(10, 2)
  totalPrice       Decimal   @map("total_price") @db.Decimal(10, 2)
  itemName         String    @map("item_name") @db.VarChar(255)
  notes            String?
  accessGranted    Boolean?  @default(false) @map("access_granted")
  accessStartDate  DateTime? @map("access_start_date") @db.Timestamptz(6)
  accessEndDate    DateTime? @map("access_end_date") @db.Timestamptz(6)
  licenseKey       String?   @map("license_key") @db.VarChar(255)
  downloadLink     String?   @map("download_link")
  refundStatus     String?   @default("none") @map("refund_status") @db.VarChar(50)
  refundAmount     Decimal?  @default(0.00) @map("refund_amount") @db.Decimal(10, 2)
  metadataJson     Json?     @map("metadata_json")
  internalComments String?   @map("internal_comments")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payments {
  id                 Int           @id @default(autoincrement())
  orderId            Int           @map("order_id")
  userId             Int           @map("user_id")
  amount             Decimal       @db.Decimal(10, 2)
  paymentMethod      String        @map("payment_method") @db.VarChar(100)
  transactionId      String        @unique @map("transaction_id") @db.VarChar(255)
  paymentStatus      String?       @default("pending") @map("payment_status") @db.VarChar(50) // ENUM 'pending', 'success', 'failed', 'refunded'
  paymentDate        DateTime      @default(now()) @map("payment_date") @db.Timestamptz(6)
  currency           String?       @default("IDR") @db.VarChar(10)
  gatewayResponse    String?       @map("gateway_response")
  fees               Decimal?      @default(0.00) @db.Decimal(10, 2)
  refundStatus       String?       @default("none") @map("refund_status") @db.VarChar(50) // ENUM 'none', 'partial', 'full'
  refundDate         DateTime?     @map("refund_date") @db.Timestamptz(6)
  receiptUrl         String?       @map("receipt_url")
  notes              String?
  capturedAt         DateTime?     @map("captured_at") @db.Timestamptz(6)
  authorizationCode  String?       @map("authorization_code") @db.VarChar(100)
  paymentGatewayName String?       @map("payment_gateway_name") @db.VarChar(100)
  errorCode          String?       @map("error_code") @db.VarChar(50)
  errorMessage       String?       @map("error_message")
  internalReference  String?       @map("internal_reference")
  metadataJson       Json?         @map("metadata_json")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              Orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCourses        UserCourses[]

  @@map("payments")
}

model Courses {
  id                     Int                @id @default(autoincrement())
  courseTitle            String             @map("course_title") @db.VarChar(255)
  description            String?
  subjectId              Int                @map("subject_id")
  difficultyLevel        String?            @default("beginner") @map("difficulty_level") @db.VarChar(50) // ENUM 'beginner', 'intermediate', 'advanced'
  price                  Decimal?           @default(0.00) @db.Decimal(10, 2)
  durationHours          Int?               @map("duration_hours")
  instructorId           Int?               @map("instructor_id")
  status                 String?            @default("draft") @db.VarChar(50) // ENUM 'draft', 'published', 'archived'
  thumbnailUrl           String?            @map("thumbnail_url")
  introductionVideoUrl   String?            @map("introduction_video_url")
  prerequisites          String?
  learningOutcomes       String?            @map("learning_outcomes")
  enrollmentCount        Int?               @default(0) @map("enrollment_count")
  rating                 Decimal?           @default(0.00) @db.Decimal(3, 2)
  reviewCount            Int?               @default(0) @map("review_count")
  lastUpdated            DateTime           @default(now()) @map("last_updated") @db.Timestamptz(6)
  syllabusPdfUrl         String?            @map("syllabus_pdf_url")
  certificationAvailable Boolean?           @default(false) @map("certification_available")
  externalCourseId       String?            @map("external_course_id") @db.VarChar(100)
  metadataJson           Json?              @map("metadata_json")
  internalNotes          String?            @map("internal_notes")
  createdByUserId        Int                @map("created_by_user_id")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subject                Subjects           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instructor             Users?             @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdByUser          Users              @relation("CourseCreatedBy", fields: [createdByUserId], references: [id])
  modules                Modules[]
  userCourses            UserCourses[]
  progressTracking       ProgressTracking[]
  certificates           Certificates[]

  @@map("courses")
}

model Modules {
  id                             Int                @id @default(autoincrement())
  courseId                       Int                @map("course_id")
  moduleTitle                    String             @map("module_title") @db.VarChar(255)
  description                    String?
  moduleOrder                    Int                @map("module_order")
  durationMinutes                Int?               @map("duration_minutes")
  isFreePreview                  Boolean?           @default(false) @map("is_free_preview")
  status                         String?            @default("draft") @db.VarChar(50) // ENUM 'draft', 'published', 'archived'
  totalLessons                   Int?               @default(0) @map("total_lessons")
  quizId                         Int?               @map("quiz_id")
  learningObjectives             String?            @map("learning_objectives")
  resourcesLinks                 Json?              @map("resources_links")
